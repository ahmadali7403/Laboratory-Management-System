
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum BranchStatus {
  ACTIVE
  INACTIVE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum PlatformAdminRole {
  SUPER_ADMIN
  SUPPORT_ADMIN
}


model PlatformAdmin {
  id                 String            @id @default(uuid()) @db.Uuid
  name               String
  username           String?           @unique
  email              String            @unique
  password           String
  role               PlatformAdminRole @default(SUPER_ADMIN)
  isActive           Boolean           @default(true)
  mustChangePassword Boolean           @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
}


model Organization {
  id        String             @id @default(uuid()) @db.Uuid
  name      String
  slug      String             @unique
  code      String             @unique
  email     String?
  phone     String?
  address   String?
  city      String?
  country   String             @default("Pakistan")
  status    OrganizationStatus @default(ACTIVE)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  branches Branch[]
  users    User[]
  roles    Role[]

  patients       Patient[]
  tests          Test[]
  orders         LabOrder[]
  payments       Payment[]
  expenses       Expense[]
  suppliers      Supplier[]
  inventoryItems InventoryItem[]
  purchases      Purchase[]
  notifications  Notification[]
  sequences      Sequence[]
  reportConsultants String?
  reportFooterNote  String?

  medicineCategories       MedicineCategory[]
  medicineCompanies        MedicineCompany[]
  medicines                Medicine[]
  medicineBatches          MedicineBatch[]
  pharmacyPurchases        PharmacyPurchase[]
  pharmacyPurchaseReturns  PharmacyPurchaseReturn[]
  pharmacySupplierPayments PharmacySupplierPayment[]
  pharmacySales            PharmacySale[]
  pharmacySaleReturns      PharmacySaleReturn[]
  pharmacyStockMovements   PharmacyStockMovement[]
  pharmacyStockAdjustments PharmacyStockAdjustment[]
  pharmacyPriceAudits      PharmacyPriceAudit[]
  pharmacyShifts           PharmacyShift[]
  auditLogs                AuditLog[]
}

model Branch {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  name           String
  code           String
  email          String?
  phone          String?
  address        String?
  city           String?
  status         BranchStatus @default(ACTIVE)
  isHeadOffice   Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  memberships  BranchMembership[]

  patients       Patient[]
  tests          Test[]
  orders         LabOrder[]
  payments       Payment[]
  expenses       Expense[]
  suppliers      Supplier[]
  inventoryItems InventoryItem[]
  purchases      Purchase[]
  notifications  Notification[]

  medicineCategories       MedicineCategory[]
  medicineCompanies        MedicineCompany[]
  medicines                Medicine[]
  medicineBatches          MedicineBatch[]
  pharmacyPurchases        PharmacyPurchase[]
  pharmacyPurchaseReturns  PharmacyPurchaseReturn[]
  pharmacySupplierPayments PharmacySupplierPayment[]
  pharmacySales            PharmacySale[]
  pharmacySaleReturns      PharmacySaleReturn[]
  pharmacyStockMovements   PharmacyStockMovement[]
  pharmacyStockAdjustments PharmacyStockAdjustment[]
  pharmacyPriceAudits      PharmacyPriceAudit[]
  pharmacyShifts           PharmacyShift[]
  auditLogs                AuditLog[]

  @@unique([organizationId, code])
  @@unique([id, organizationId])
  @@index([organizationId, status])
  roles Role[]
}

model User {
  id                 String     @id @default(uuid()) @db.Uuid
  organizationId     String     @db.Uuid
  name               String
  email              String
  username           String?    @unique
  password           String
  passwordEncrypted  String?
  pinHash            String?
  mustChangePassword Boolean    @default(false)
  phone              String?
  status             UserStatus @default(ACTIVE)
  lastLoginAt        DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  memberships    BranchMembership[]
  userRoles      UserRole[]
  pharmacyShifts PharmacyShift[]

  @@unique([organizationId, email])
  @@unique([id, organizationId])
  @@index([organizationId, status])
}

model BranchMembership {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  userId         String   @db.Uuid
  branchId       String   @db.Uuid
  createdAt      DateTime @default(now())

  user   User   @relation(fields: [userId, organizationId], references: [id, organizationId], onDelete: Cascade)
  branch Branch @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([userId, branchId])
  @@index([organizationId, branchId])
}

model Role {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  branchId       String?  @db.Uuid // null = organization-wide role; set = role exists only in that branch
  name           String
  description    String?
  isSystem       Boolean  @default(false)
  maxDiscountPct Decimal  @default(100) @db.Decimal(5, 2)
  canEditPrice   Boolean  @default(true)
  allowedMethods String[] @default([])
  requireShift   Boolean  @default(false)
  settings       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  userRoles    UserRole[]
  permissions  RolePermission[]

  @@unique([organizationId, branchId, name])
  @@unique([id, organizationId])
  @@index([organizationId, branchId])
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]
}

model UserRole {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  userId         String   @db.Uuid
  roleId         String   @db.Uuid
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId, organizationId], references: [id, organizationId], onDelete: Cascade)
  role Role @relation(fields: [roleId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([organizationId])
}

model RolePermission {
  id           String @id @default(uuid()) @db.Uuid
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

// ---------------------------------------------------------------------------
// LABORATORY DOMAIN
// Tenant rule: every row carries organizationId; branch-owned rows also carry
// branchId. Composite foreign keys (id, organizationId) make it impossible at
// database level to link a row to a branch/patient/test of another organization.
// ---------------------------------------------------------------------------

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum OrderStatus {
  REGISTERED
  SAMPLE_COLLECTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum SampleStatus {
  PENDING
  COLLECTED
  RECEIVED
  REJECTED
}

enum ResultStatus {
  PENDING
  ENTERED
  VERIFIED
}

enum ResultFlag {
  NORMAL
  LOW
  HIGH
  CRITICAL
  ABNORMAL
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  ONLINE
  JAZZCASH
  EASYPAISA
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum PurchaseStatus {
  ORDERED
  RECEIVED
  CANCELLED
}

model PlatformSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Sequence {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  key            String
  value          Int    @default(0)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
}

model Patient {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  branchId       String    @db.Uuid
  mrn            String
  name           String
  fatherName     String?
  isWalkIn       Boolean   @default(false)
  gender         Gender    @default(OTHER)
  dateOfBirth    DateTime? @db.Date
  phone          String?
  email          String?
  cnic           String?
  address        String?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch        Branch         @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)
  orders        LabOrder[]
  pharmacySales PharmacySale[]

  @@unique([organizationId, mrn])
  @@unique([id, organizationId])
  @@index([organizationId, branchId, createdAt])
  @@index([organizationId, name])
  @@index([organizationId, phone])
  @@index([branchId, name])
  @@index([branchId, phone])
}

model Test {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @db.Uuid
  branchId        String?  @db.Uuid
  code            String
  name            String
  category        String?
  sampleType      String   @default("Blood")
  price           Decimal  @db.Decimal(12, 2)
  unit            String?
  refLow          Decimal? @db.Decimal(12, 4)
  refHigh         Decimal? @db.Decimal(12, 4)
  refRangeText    String?
  turnaroundHours Int?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch?         @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)
  orderItems   LabOrderItem[]
  parameters   TestParameter[]

  @@unique([organizationId, code])
  @@unique([id, organizationId])
  @@index([organizationId, branchId, isActive])
  @@index([organizationId, name])
}

model LabOrder {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @db.Uuid
  branchId       String      @db.Uuid
  orderNo        String
  patientId      String      @db.Uuid
  status         OrderStatus @default(REGISTERED)
  paymentStatus  PaymentStatus @default(UNPAID)
  subtotal       Decimal     @db.Decimal(12, 2)
  discount       Decimal     @default(0) @db.Decimal(12, 2)
  total          Decimal     @db.Decimal(12, 2)
  paidAmount     Decimal     @default(0) @db.Decimal(12, 2)
  notes          String?
  referredBy     String?
  createdByName  String
  completedAt    DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch         @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)
  patient      Patient        @relation(fields: [patientId, organizationId], references: [id, organizationId], onDelete: Restrict)
  items        LabOrderItem[]
  samples      Sample[]
  payments     Payment[]

  @@unique([organizationId, orderNo])
  @@unique([id, organizationId])
  @@index([organizationId, branchId, createdAt])
  @@index([organizationId, createdAt])
  @@index([branchId, status])
  @@index([branchId, paymentStatus])
  @@index([patientId])
}

model Sample {
  id              String       @id @default(uuid()) @db.Uuid
  orderId         String       @db.Uuid
  sampleNo        String
  sampleType      String
  status          SampleStatus @default(PENDING)
  collectedAt     DateTime?
  collectedByName String?
  rejectionReason String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  order LabOrder        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items LabOrderItem[]

  @@unique([orderId, sampleType])
  @@index([status])
}

model LabOrderItem {
  id             String       @id @default(uuid()) @db.Uuid
  orderId        String       @db.Uuid
  testId         String       @db.Uuid
  sampleId       String?      @db.Uuid
  testName       String
  testCode       String
  price          Decimal      @db.Decimal(12, 2)
  resultValue    String?
  unit           String?
  refRange       String?
  flag           ResultFlag   @default(NORMAL)
  resultStatus   ResultStatus @default(PENDING)
  comments       String?
  enteredByName  String?
  enteredAt      DateTime?
  verifiedByName String?
  verifiedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  order  LabOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  test   Test     @relation(fields: [testId], references: [id], onDelete: Restrict)
  sample Sample?  @relation(fields: [sampleId], references: [id], onDelete: SetNull)
  results LabResult[]

  @@index([orderId])
  @@index([resultStatus])
  @@index([testId])
}

model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  branchId       String        @db.Uuid
  orderId        String?       @db.Uuid
  pharmacySaleId String?       @db.Uuid
  amount         Decimal       @db.Decimal(12, 2)
  method         PaymentMethod @default(CASH)
  reference      String?
  receivedByName String
  createdAt      DateTime      @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch        @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)
  order        LabOrder?     @relation(fields: [orderId, organizationId], references: [id, organizationId], onDelete: Restrict)
  pharmacySale PharmacySale? @relation(fields: [pharmacySaleId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([organizationId, branchId, createdAt])
  @@index([organizationId, createdAt])
  @@index([orderId])
  @@index([pharmacySaleId])
}

model Expense {
  id            String   @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  branchId      String   @db.Uuid
  category      String
  description   String?
  amount        Decimal  @db.Decimal(12, 2)
  expenseDate   DateTime @db.Date
  paymentMethod String   @default("CASH")
  createdByName String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch       @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([organizationId, branchId, expenseDate])
}

model Supplier {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @db.Uuid
  branchId        String?  @db.Uuid
  name            String
  contactPerson   String?
  phone           String?
  email           String?
  address         String?
  pharmacyBalance Decimal  @default(0) @db.Decimal(12, 2)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization             Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch                   Branch?                   @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)
  purchases                Purchase[]
  medicines                Medicine[]
  medicineBatches          MedicineBatch[]
  pharmacyPurchases        PharmacyPurchase[]
  pharmacyPurchaseReturns  PharmacyPurchaseReturn[]
  pharmacySupplierPayments PharmacySupplierPayment[]

  @@unique([id, organizationId])
  @@index([organizationId, branchId, isActive])
}

model InventoryItem {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  branchId       String   @db.Uuid
  name           String
  sku            String?
  unit           String   @default("pcs")
  quantity       Decimal  @default(0) @db.Decimal(12, 2)
  reorderLevel   Decimal  @default(0) @db.Decimal(12, 2)
  unitCost       Decimal? @db.Decimal(12, 2)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch        Branch         @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)
  purchaseItems PurchaseItem[]

  @@unique([branchId, name])
  @@unique([id, organizationId])
  @@index([organizationId, branchId, isActive])
}

model Purchase {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  branchId       String         @db.Uuid
  purchaseNo     String
  supplierId     String         @db.Uuid
  status         PurchaseStatus @default(ORDERED)
  total          Decimal        @db.Decimal(12, 2)
  purchaseDate   DateTime       @db.Date
  notes          String?
  receivedAt     DateTime?
  createdByName  String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch         @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)
  supplier     Supplier       @relation(fields: [supplierId, organizationId], references: [id, organizationId], onDelete: Restrict)
  items        PurchaseItem[]

  @@unique([organizationId, purchaseNo])
  @@index([organizationId, branchId, purchaseDate])
}

model PurchaseItem {
  id              String  @id @default(uuid()) @db.Uuid
  purchaseId      String  @db.Uuid
  inventoryItemId String  @db.Uuid
  quantity        Decimal @db.Decimal(12, 2)
  unitCost        Decimal @db.Decimal(12, 2)

  purchase      Purchase      @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@index([purchaseId])
}

model Notification {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  branchId       String?  @db.Uuid
  type           String
  title          String
  message        String
  link           String?
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([organizationId, branchId, isRead, createdAt])
}

// A test (panel) such as CBC / LFT owns many parameters (WBC, RBC, ...).
model TestParameter {
  id           String   @id @default(uuid()) @db.Uuid
  testId       String   @db.Uuid
  name         String
  unit         String?
  refLow       Decimal? @db.Decimal(12, 4)
  refHigh      Decimal? @db.Decimal(12, 4)
  refRangeText String?
  sortOrder    Int      @default(0)

  test Test @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@index([testId, sortOrder])
}

// Per-order snapshot of each parameter + its entered value.
model LabResult {
  id           String     @id @default(uuid()) @db.Uuid
  orderItemId  String     @db.Uuid
  name         String
  unit         String?
  refLow       Decimal?   @db.Decimal(12, 4)
  refHigh      Decimal?   @db.Decimal(12, 4)
  refRangeText String?
  sortOrder    Int        @default(0)
  value        String?
  flag         ResultFlag @default(NORMAL)

  orderItem LabOrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId, sortOrder])
}

// ---------------------------------------------------------------------------
// PHARMACY DOMAIN
// Tenant rule: every row carries organizationId; branch-owned rows carry
// branchId and composite (id, organizationId) foreign keys.
// ---------------------------------------------------------------------------

enum MedicineStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
}

enum PharmacyPurchaseStatus {
  DRAFT
  ORDERED
  FINALIZED
  CANCELLED
}

enum PharmacySaleStatus {
  COMPLETED
  PARTIAL_RETURN
  RETURNED
  CANCELLED
}

enum PharmacyStockMovementType {
  INITIAL_STOCK
  PURCHASE_IN
  SALE_OUT
  ADJUSTMENT_ADD
  ADJUSTMENT_SUB
  PURCHASE_RETURN_OUT
  SALE_RETURN_IN
  SALE_CANCEL_RESTORE
}

enum PharmacyAdjustmentType {
  INCREASE
  DECREASE
  DAMAGED
  EXPIRED_WRITE_OFF
  CORRECTION
}

model MedicineCategory {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  branchId       String?  @db.Uuid
  name           String
  description    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch?      @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)
  medicines    Medicine[]

  @@unique([id, organizationId])
  @@index([organizationId, branchId, isActive])
  @@index([organizationId, name])
}

model MedicineCompany {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  branchId       String?  @db.Uuid
  name           String
  country        String?
  phone          String?
  email          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch?      @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)
  medicines    Medicine[]

  @@unique([id, organizationId])
  @@index([organizationId, branchId, isActive])
  @@index([organizationId, name])
}

model Medicine {
  id                   String         @id @default(uuid()) @db.Uuid
  organizationId       String         @db.Uuid
  branchId             String         @db.Uuid
  name                 String
  genericName          String?
  categoryId           String?        @db.Uuid
  companyId            String?        @db.Uuid
  defaultSupplierId    String?        @db.Uuid
  strength             String?
  dosageForm           String?
  unit                 String         @default("pcs")
  packSize             Int            @default(1)
  barcode              String?
  sku                  String?
  lowStockAlert        Decimal        @default(10) @db.Decimal(12, 2)
  defaultPurchasePrice Decimal        @default(0) @db.Decimal(12, 2)
  defaultSalePrice     Decimal        @default(0) @db.Decimal(12, 2)
  rackLocation         String?
  description          String?
  status               MedicineStatus @default(ACTIVE)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  organization       Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch             Branch                    @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)
  category           MedicineCategory?         @relation(fields: [categoryId, organizationId], references: [id, organizationId], onDelete: Restrict)
  company            MedicineCompany?          @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Restrict)
  defaultSupplier    Supplier?                 @relation(fields: [defaultSupplierId, organizationId], references: [id, organizationId], onDelete: Restrict)
  batches            MedicineBatch[]
  purchaseItems      PharmacyPurchaseItem[]
  saleItems          PharmacySaleItem[]
  stockMovements     PharmacyStockMovement[]
  stockAdjustments   PharmacyStockAdjustment[]
  priceAudits        PharmacyPriceAudit[]

  @@unique([id, organizationId])
  @@index([organizationId, branchId, status])
  @@index([organizationId, branchId, name])
  @@index([organizationId, branchId, genericName])
  @@index([organizationId, branchId, barcode])
  @@index([organizationId, branchId, sku])
  @@index([organizationId, branchId, updatedAt])
}

model MedicineBatch {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @db.Uuid
  branchId        String    @db.Uuid
  medicineId      String    @db.Uuid
  batchNumber     String
  expiryDate      DateTime  @db.Date
  purchasePrice   Decimal   @db.Decimal(12, 2)
  salePrice       Decimal   @db.Decimal(12, 2)
  mrp             Decimal?  @db.Decimal(12, 2)
  initialQuantity Decimal   @db.Decimal(12, 2)
  quantity        Decimal   @db.Decimal(12, 2)
  supplierId      String?   @db.Uuid
  purchaseId      String?   @db.Uuid
  isActive        Boolean   @default(true)
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization        Organization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch              Branch                       @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)
  medicine            Medicine                     @relation(fields: [medicineId, organizationId], references: [id, organizationId], onDelete: Restrict)
  supplier            Supplier?                    @relation(fields: [supplierId, organizationId], references: [id, organizationId], onDelete: Restrict)
  purchase            PharmacyPurchase?            @relation(fields: [purchaseId, organizationId], references: [id, organizationId], onDelete: Restrict)
  purchaseItems       PharmacyPurchaseItem[]
  purchaseReturnItems PharmacyPurchaseReturnItem[]
  saleItems           PharmacySaleItem[]
  saleReturnItems     PharmacySaleReturnItem[]
  stockMovements      PharmacyStockMovement[]
  stockAdjustments    PharmacyStockAdjustment[]
  priceAudits         PharmacyPriceAudit[]

  @@unique([id, organizationId])
  @@index([organizationId, branchId, medicineId, expiryDate])
  @@index([organizationId, branchId, batchNumber])
  @@index([organizationId, branchId, expiryDate])
  @@index([organizationId, branchId, quantity])
}

model PharmacyPurchase {
  id                String                 @id @default(uuid()) @db.Uuid
  organizationId    String                 @db.Uuid
  branchId          String                 @db.Uuid
  purchaseNo        String
  supplierId        String                 @db.Uuid
  invoiceNo         String?
  status            PharmacyPurchaseStatus @default(ORDERED)
  paymentStatus     PaymentStatus          @default(UNPAID)
  subtotal          Decimal                @db.Decimal(12, 2)
  discount          Decimal                @default(0) @db.Decimal(12, 2)
  additionalCharges Decimal                @default(0) @db.Decimal(12, 2)
  total             Decimal                @db.Decimal(12, 2)
  paidAmount        Decimal                @default(0) @db.Decimal(12, 2)
  returnedAmount    Decimal                @default(0) @db.Decimal(12, 2)
  paymentMethod     PaymentMethod          @default(CASH)
  purchaseDate      DateTime               @db.Date
  stockApplied      Boolean                @default(false)
  finalizedAt       DateTime?
  cancelledAt       DateTime?
  notes             String?
  createdByName     String
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  organization     Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch           Branch                    @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)
  supplier         Supplier                  @relation(fields: [supplierId, organizationId], references: [id, organizationId], onDelete: Restrict)
  items            PharmacyPurchaseItem[]
  createdBatches   MedicineBatch[]
  returns          PharmacyPurchaseReturn[]
  supplierPayments PharmacySupplierPayment[]

  @@unique([organizationId, purchaseNo])
  @@unique([id, organizationId])
  @@index([organizationId, branchId, purchaseDate])
  @@index([organizationId, branchId, status])
  @@index([supplierId])
}

model PharmacyPurchaseItem {
  id               String   @id @default(uuid()) @db.Uuid
  purchaseId       String   @db.Uuid
  medicineId       String   @db.Uuid
  batchId          String?  @db.Uuid
  batchNumber      String
  expiryDate       DateTime @db.Date
  quantity         Decimal  @db.Decimal(12, 2)
  returnedQuantity Decimal  @default(0) @db.Decimal(12, 2)
  purchasePrice    Decimal  @db.Decimal(12, 2)
  salePrice        Decimal  @db.Decimal(12, 2)
  lineTotal        Decimal  @db.Decimal(12, 2)

  purchase    PharmacyPurchase             @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  medicine    Medicine                     @relation(fields: [medicineId], references: [id], onDelete: Restrict)
  batch       MedicineBatch?               @relation(fields: [batchId], references: [id], onDelete: SetNull)
  returnItems PharmacyPurchaseReturnItem[]

  @@index([purchaseId])
  @@index([medicineId])
}

model PharmacyPurchaseReturn {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  branchId       String   @db.Uuid
  returnNo       String
  purchaseId     String   @db.Uuid
  supplierId     String   @db.Uuid
  total          Decimal  @db.Decimal(12, 2)
  reason         String?
  createdByName  String
  createdAt      DateTime @default(now())

  organization Organization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch                       @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)
  purchase     PharmacyPurchase             @relation(fields: [purchaseId, organizationId], references: [id, organizationId], onDelete: Restrict)
  supplier     Supplier                     @relation(fields: [supplierId, organizationId], references: [id, organizationId], onDelete: Restrict)
  items        PharmacyPurchaseReturnItem[]

  @@unique([organizationId, returnNo])
  @@index([organizationId, branchId, createdAt])
}

model PharmacyPurchaseReturnItem {
  id               String  @id @default(uuid()) @db.Uuid
  returnId         String  @db.Uuid
  purchaseItemId   String  @db.Uuid
  batchId          String  @db.Uuid
  quantity         Decimal @db.Decimal(12, 2)
  unitPrice        Decimal @db.Decimal(12, 2)
  lineTotal        Decimal @db.Decimal(12, 2)

  purchaseReturn PharmacyPurchaseReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  purchaseItem   PharmacyPurchaseItem   @relation(fields: [purchaseItemId], references: [id], onDelete: Restrict)
  batch          MedicineBatch          @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@index([returnId])
}

model PharmacySupplierPayment {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  branchId       String        @db.Uuid
  supplierId     String        @db.Uuid
  purchaseId     String?       @db.Uuid
  amount         Decimal       @db.Decimal(12, 2)
  method         PaymentMethod @default(CASH)
  reference      String?
  notes          String?
  paidByName     String
  createdAt      DateTime      @default(now())

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch            @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)
  supplier     Supplier          @relation(fields: [supplierId, organizationId], references: [id, organizationId], onDelete: Restrict)
  purchase     PharmacyPurchase? @relation(fields: [purchaseId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([organizationId, branchId, createdAt])
  @@index([supplierId])
}

model PharmacySale {
  id                String             @id @default(uuid()) @db.Uuid
  organizationId    String             @db.Uuid
  branchId          String             @db.Uuid
  saleNo            String
  patientId         String?            @db.Uuid
  customerName      String             @default("Walk-in Customer")
  customerPhone     String?
  isWalkIn          Boolean            @default(true)
  status            PharmacySaleStatus @default(COMPLETED)
  paymentStatus     PaymentStatus      @default(PAID)
  subtotal          Decimal            @db.Decimal(12, 2)
  itemDiscountTotal Decimal            @default(0) @db.Decimal(12, 2)
  discount          Decimal            @default(0) @db.Decimal(12, 2)
  total             Decimal            @db.Decimal(12, 2)
  paidAmount        Decimal            @default(0) @db.Decimal(12, 2)
  refundedAmount    Decimal            @default(0) @db.Decimal(12, 2)
  notes             String?
  soldByName        String
  cancelledAt       DateTime?
  cancelReason      String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch               @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)
  patient      Patient?             @relation(fields: [patientId, organizationId], references: [id, organizationId], onDelete: Restrict)
  items        PharmacySaleItem[]
  payments     Payment[]
  returns      PharmacySaleReturn[]

  @@unique([organizationId, saleNo])
  @@unique([id, organizationId])
  @@index([organizationId, branchId, createdAt])
  @@index([organizationId, createdAt])
  @@index([organizationId, branchId, status])
  @@index([organizationId, branchId, paymentStatus])
  @@index([organizationId, branchId, soldByName])
}

model PharmacySaleItem {
  id               String   @id @default(uuid()) @db.Uuid
  saleId           String   @db.Uuid
  medicineId       String   @db.Uuid
  batchId          String   @db.Uuid
  medicineName     String
  genericName      String?
  strength         String?
  batchNumber      String
  expiryDate       DateTime @db.Date
  quantity         Decimal  @db.Decimal(12, 2)
  returnedQuantity Decimal  @default(0) @db.Decimal(12, 2)
  unitPrice        Decimal  @db.Decimal(12, 2)
  costPrice        Decimal  @db.Decimal(12, 2)
  discount         Decimal  @default(0) @db.Decimal(12, 2)
  lineTotal        Decimal  @db.Decimal(12, 2)

  sale        PharmacySale             @relation(fields: [saleId], references: [id], onDelete: Cascade)
  medicine    Medicine                 @relation(fields: [medicineId], references: [id], onDelete: Restrict)
  batch       MedicineBatch            @relation(fields: [batchId], references: [id], onDelete: Restrict)
  returnItems PharmacySaleReturnItem[]

  @@index([saleId])
  @@index([medicineId])
  @@index([batchId])
}

model PharmacySaleReturn {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  branchId       String   @db.Uuid
  returnNo       String
  saleId         String   @db.Uuid
  total          Decimal  @db.Decimal(12, 2)
  refundAmount   Decimal  @default(0) @db.Decimal(12, 2)
  reason         String?
  createdByName  String
  createdAt      DateTime @default(now())

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch                   @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)
  sale         PharmacySale             @relation(fields: [saleId, organizationId], references: [id, organizationId], onDelete: Restrict)
  items        PharmacySaleReturnItem[]

  @@unique([organizationId, returnNo])
  @@index([organizationId, branchId, createdAt])
}

model PharmacySaleReturnItem {
  id         String  @id @default(uuid()) @db.Uuid
  returnId   String  @db.Uuid
  saleItemId String  @db.Uuid
  batchId    String  @db.Uuid
  quantity   Decimal @db.Decimal(12, 2)
  unitPrice  Decimal @db.Decimal(12, 2)
  lineTotal  Decimal @db.Decimal(12, 2)

  saleReturn PharmacySaleReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  saleItem   PharmacySaleItem   @relation(fields: [saleItemId], references: [id], onDelete: Restrict)
  batch      MedicineBatch      @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@index([returnId])
}

model PharmacyStockMovement {
  id             String                    @id @default(uuid()) @db.Uuid
  organizationId String                    @db.Uuid
  branchId       String                    @db.Uuid
  medicineId     String                    @db.Uuid
  batchId        String                    @db.Uuid
  type           PharmacyStockMovementType
  quantityChange Decimal                   @db.Decimal(12, 2)
  balanceBefore  Decimal                   @db.Decimal(12, 2)
  balanceAfter   Decimal                   @db.Decimal(12, 2)
  referenceType  String?
  referenceId    String?
  referenceNo    String?
  reason         String?
  createdByName  String
  createdAt      DateTime                  @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch        @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)
  medicine     Medicine      @relation(fields: [medicineId, organizationId], references: [id, organizationId], onDelete: Restrict)
  batch        MedicineBatch @relation(fields: [batchId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([organizationId, branchId, createdAt])
  @@index([medicineId, createdAt])
  @@index([batchId, createdAt])
}

model PharmacyStockAdjustment {
  id             String                 @id @default(uuid()) @db.Uuid
  organizationId String                 @db.Uuid
  branchId       String                 @db.Uuid
  medicineId     String                 @db.Uuid
  batchId        String                 @db.Uuid
  adjustmentType PharmacyAdjustmentType
  quantity       Decimal                @db.Decimal(12, 2)
  previousStock  Decimal                @db.Decimal(12, 2)
  newStock       Decimal                @db.Decimal(12, 2)
  reason         String
  adjustedByName String
  createdAt      DateTime               @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch        @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)
  medicine     Medicine      @relation(fields: [medicineId, organizationId], references: [id, organizationId], onDelete: Restrict)
  batch        MedicineBatch @relation(fields: [batchId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([organizationId, branchId, createdAt])
  @@index([medicineId])
}

model PharmacyPriceAudit {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @db.Uuid
  branchId         String   @db.Uuid
  medicineId       String   @db.Uuid
  batchId          String?  @db.Uuid
  oldPurchasePrice Decimal? @db.Decimal(12, 2)
  newPurchasePrice Decimal? @db.Decimal(12, 2)
  oldSalePrice     Decimal? @db.Decimal(12, 2)
  newSalePrice     Decimal? @db.Decimal(12, 2)
  reason           String?
  changedByName    String
  createdAt        DateTime @default(now())

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch         @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)
  medicine     Medicine       @relation(fields: [medicineId, organizationId], references: [id, organizationId], onDelete: Restrict)
  batch        MedicineBatch? @relation(fields: [batchId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([organizationId, branchId, createdAt])
  @@index([medicineId])
}

enum PharmacyShiftStatus {
  OPEN
  CLOSED
}

model PharmacyShift {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @db.Uuid
  branchId       String              @db.Uuid
  userId         String              @db.Uuid
  cashierName    String
  openingCash    Decimal             @default(0) @db.Decimal(12, 2)
  closingCash    Decimal?            @db.Decimal(12, 2)
  expectedCash   Decimal?            @db.Decimal(12, 2)
  totalSales     Decimal             @default(0) @db.Decimal(12, 2)
  cashSales      Decimal             @default(0) @db.Decimal(12, 2)
  cardSales      Decimal             @default(0) @db.Decimal(12, 2)
  mobileSales    Decimal             @default(0) @db.Decimal(12, 2)
  bankSales      Decimal             @default(0) @db.Decimal(12, 2)
  salesCount     Int                 @default(0)
  status         PharmacyShiftStatus @default(OPEN)
  notes          String?
  openedAt       DateTime            @default(now())
  closedAt       DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch       @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)
  user         User         @relation(fields: [userId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([organizationId, branchId, openedAt])
  @@index([userId, status])
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @db.Uuid
  branchId       String?  @db.Uuid
  userId         String?  @db.Uuid
  actorName      String
  actorRole      String
  action         String
  resource       String
  resourceId     String?
  summary        String
  meta           Json?
  ip             String?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?       @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([branchId, createdAt])
  @@index([action, createdAt])
}
